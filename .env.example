# Copy to .env locally (never commit). Used by Electron host at runtime / packaging.

# --- AI ---
# GENMAIL_AI_API_KEY=
# XAI_API_KEY=
# GENMAIL_AI_BASE_URL=https://api.x.ai/v1
# GENMAIL_AI_MODEL=grok-4.7

# --- External UI (optional). Unset this to boot the bundled renderer. ---
# GENMAIL_ASAR=/absolute/path/to/app.asar

# --- Google Desktop OAuth (from Morrow-Mail GitHub secret GOOGLE_DESKTOP_OAUTH_JSON) ---
# Paste the Desktop client JSON (must contain "installed": { client_id, client_secret }).
# GENMAIL_GOOGLE_OAUTH_JSON={"installed":{"client_id":"….apps.googleusercontent.com","client_secret":"…"}}
# Or path to the downloaded JSON:
# GENMAIL_GOOGLE_OAUTH_FILE=/absolute/path/google-desktop-oauth.json
# Morrow-Mail aliases also accepted: GOOGLE_DESKTOP_OAUTH_JSON (Actions secret name; local/runtime too), MORROW_GOOGLE_OAUTH_JSON / MORROW_GOOGLE_OAUTH_FILE

# --- Microsoft OAuth ---
# Public desktop client ID is committed at shared/microsoft-client-id.txt
# (same as Morrow-Mail). No client secret. Entra app must allow public client
# flows and register BOTH localhost paths (port is chosen at runtime):
#   /api/oauth/microsoft/callback
#   /api/calendar-oauth/microsoft/callback
# IMAP baseline (first consent): offline_access, IMAP.AccessAsUser.All, SMTP.Send.
# Organize side-car also asks for User.Read, Mail.ReadWrite, Mail.Send.
# Calendar purpose asks for offline_access, User.Read, Calendars.ReadWrite.
# Work/school tenants need admin consent on the shared app. See docs/OAUTH.md.

# --- Private GitHub Releases updater (packaged builds) ---
# GH_TOKEN=ghp_…   # repo scope on Coke1120/genmail-rea
# GITHUB_TOKEN=

# --- Tests ---
# GENMAIL_MAIL_SECRETS=memory
# GENMAIL_AI_SELFTEST=1
# GENMAIL_MAIL_SELFTEST=1
