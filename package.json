{
  "name": "morrow-mail",
  "version": "0.2.33",
  "description": "Morrow Mail. Open-source Electron mail client for Windows and macOS. Connect your own accounts, read and send mail, and install from GitHub Releases.",
  "main": "host/main.js",
  "private": true,
  "author": "Leo Ho",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-boot-path.js",
    "bot:call": "node scripts/morrow-bot-call.js",
    "postinstall": "node scripts/bundle-motion.js && node scripts/bundle-pdf.js",
    "motion:bundle": "node scripts/bundle-motion.js",
    "pdf:bundle": "node scripts/bundle-pdf.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dir zip",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir zip",
    "publish:github": "electron-builder --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.3.9",
    "imapflow": "^2.5.0",
    "mailparser": "^3.9.39",
    "motion": "^14.3.0",
    "nodemailer": "^10.1.1",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "4.10.38",
    "pe-library": "^1.0.1",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.coke1120.morrow-mail",
    "productName": "Morrow Mail",
    "copyright": "Copyright (c) 2026 Leo Ho / HWL-HK",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "host/**/*",
      "renderer/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE",
      "!host/**/*.test.js",
      "!**/*.map",
      "!node_modules/motion/**",
      "!node_modules/framer-motion/**",
      "!node_modules/motion-dom/**",
      "!node_modules/motion-utils/**"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "**/*",
          "!**/.gitkeep"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "afterPack": "./scripts/windows-icon.js",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "detectUpdateChannel": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Coke1120",
        "repo": "Morrow-Mail",
        "private": false,
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir",
        "zip"
      ],
      "icon": "build/icon.icns",
      "sign": "./scripts/sign-macos.js",
      "notarize": false,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Morrow-Mail-${arch}-mac.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "Morrow Mail",
        "CFBundleName": "Morrow Mail"
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Morrow-Mail-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Morrow-Mail.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
