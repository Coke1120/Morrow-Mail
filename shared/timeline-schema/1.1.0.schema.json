{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:morrow-mail:timeline:1.1.0",
  "title": "Portable Email Timeline with Case Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "timeline_id",
    "source_namespace",
    "generator",
    "generated_at",
    "title",
    "display_timezone",
    "time_basis",
    "coverage",
    "source_threads",
    "events"
  ],
  "properties": {
    "$schema": {
      "const": "urn:morrow-mail:timeline:1.1.0"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "timeline_id": {
      "$ref": "#/$defs/id"
    },
    "source_namespace": {
      "$ref": "#/$defs/id"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "display_timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "time_basis": {
      "const": "mail_timestamp"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_message_count",
        "included_message_count",
        "omitted_message_count",
        "selection_truncated"
      ],
      "properties": {
        "selected_message_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "included_message_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "omitted_message_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "selection_truncated": {
          "type": "boolean"
        }
      }
    },
    "source_threads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "selected_message_count"
        ],
        "properties": {
          "thread_id": {
            "$ref": "#/$defs/id"
          },
          "selected_message_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "case_report": {
      "$ref": "#/$defs/case_report"
    },
    "case_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_only",
        "account_count",
        "search_count",
        "limited_search_count",
        "mailbox_complete",
        "search_is_exhaustive"
      ],
      "properties": {
        "local_only": {
          "const": true
        },
        "account_count": {
          "const": 1
        },
        "search_count": {
          "type": "integer",
          "minimum": 0
        },
        "limited_search_count": {
          "type": "integer",
          "minimum": 0
        },
        "mailbox_complete": {
          "const": false
        },
        "search_is_exhaustive": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\u0000-\u001f  ]+$"
    },
    "address": {
      "type": "string",
      "format": "email",
      "maxLength": 320
    },
    "mailbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\u0000-\\u001F\\u007F\\u2028\\u2029]+$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "source_thread_id",
        "source_message_id",
        "occurred_at",
        "date_source",
        "from",
        "to",
        "cc",
        "via_alias",
        "summary",
        "attachments",
        "open_actions",
        "unclear"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "source_thread_id": {
          "$ref": "#/$defs/id"
        },
        "source_message_id": {
          "$ref": "#/$defs/id"
        },
        "occurred_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_source": {
          "enum": [
            "header",
            "received",
            "cached_unknown",
            "unknown"
          ]
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/mailbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/mailbox"
          }
        },
        "cc": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/mailbox"
          }
        },
        "via_alias": {
          "anyOf": [
            {
              "$ref": "#/$defs/address"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "attachments": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/filename"
          }
        },
        "open_actions": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "unclear": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "phase": {
          "enum": [
            "main",
            "background"
          ]
        }
      }
    },
    "case_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_message_ids",
        "uncertainty"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "source_message_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "uncertainty": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "case_date": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_message_ids",
        "uncertainty",
        "kind",
        "date_text"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "source_message_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "uncertainty": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "event",
            "deadline"
          ]
        },
        "date_text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "case_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_status",
        "follow_ups",
        "gaps",
        "dates"
      ],
      "properties": {
        "current_status": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/case_item"
          }
        },
        "follow_ups": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/case_item"
          }
        },
        "gaps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/case_item"
          }
        },
        "dates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/case_date"
          }
        }
      }
    }
  },
  "dependentRequired": {
    "case_report": [
      "case_scope"
    ],
    "case_scope": [
      "case_report"
    ]
  }
}
