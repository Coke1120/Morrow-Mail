{
  "apiVersion": "1.0",
  "transport": {
    "method": "POST",
    "path": "/api/bot/v1/call",
    "bind": "127.0.0.1",
    "port": 47831,
    "contentType": "application/json; charset=utf-8",
    "accept": "application/json",
    "authorization": "Bearer",
    "capabilityHeader": "Tailscale-App-Capabilities",
    "capability": "com.coke1120.morrow-mail/bot-access",
    "capabilityValue": [{ "readBridge": true }],
    "funnel": false
  },
  "request": ["apiVersion", "requestId", "installationId", "operation", "params"],
  "operations": {
    "bridge.describe": [],
    "accounts.list": [],
    "mail.list_cached": ["accountId", "folder", "limit"],
    "mail.search_cached": ["accountId", "query", "limit"],
    "mail.get_cached": ["accountId", "messageId", "maxBodyBytes"],
    "mail.attachment.get": ["accountId", "messageId", "index"],
    "health.get": ["accountId"],
    "agent.proposals.list": ["accountId", "limit"],
    "draft.proposals.submit": ["accountId", "idempotencyKey", "to", "cc", "bcc", "subject", "bodyText", "inReplyToMessageId"],
    "draft.proposals.list": ["accountId", "limit"],
    "mail.send": ["accountId", "fromAddress", "to", "cc", "bcc", "subject", "bodyText", "inReplyToMessageId"],
    "mail.archive": ["accountId", "messageId"],
    "mail.mark_read": ["accountId", "messageId", "isRead"],
    "mail.trash": ["accountId", "messageId"]
  },
  "platforms": [
    "grok_bot",
    "hermes_agent"
  ],
  "mailChanges": {
    "capabilities": ["mail.archive", "mail.read_state.write", "mail.trash"],
    "defaultEnabled": false,
    "maxMessagesPerRequest": 1,
    "requestId": "required-uuid",
    "replay": "observe the same operation and params; never resubmit",
    "states": ["pending", "completed", "failed", "not_attempted", "superseded", "unknown"],
    "providerConfirmation": "completed with providerConfirmed true",
    "permanentDeletion": false,
    "arbitraryFolderMoves": false,
    "resumeQueuedAfterRestart": false
  },
  "proactiveNotify": {
    "kind": "proactive.mail_digest",
    "contentTrust": "untrusted_mail_data",
    "method": "POST",
    "fields": [
      "apiVersion",
      "kind",
      "deliveryId",
      "installationId",
      "botId",
      "platform",
      "generatedAt",
      "contentTrust",
      "accounts"
    ],
    "accountFields": [
      "accountId",
      "folder",
      "messages",
      "moreAvailable",
      "warnings"
    ],
    "configuration": "desktop Settings only; separate per-bot background opt-in and active listener",
    "decisionOwner": "platform_bot",
    "maxPayloadBytes": 131072,
    "maxResponseBytes": 8192,
    "timeoutMs": 10000,
    "maxAttemptsPerSlot": 2,
    "candidateWindowPerAccount": 50,
    "maxMessagesPerAccount": 10,
    "rememberedIdsPerAccount": 2000,
    "attachmentBytes": false,
    "forceDownload": false,
    "funnel": false
  }
}
